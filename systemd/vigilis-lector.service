[Unit]
Description=Vigilis Lector hardware metrics collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{WORKDIR}}
ExecStart=/usr/bin/python3 {{WORKDIR}}/collection.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
